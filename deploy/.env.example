# Variables de production de LanGestLoc.
# Copier en `.env` à côté de compose.prod.yml, remplir, puis `chmod 600 .env`.
# Ne jamais committer le vrai fichier.

# ── Image ─────────────────────────────────────────────────────────────────────
# SHA complet du commit dont la CI a publié l'image (job « Image Docker » sur main)
API_IMAGE_TAG=

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=langestloc
# openssl rand -hex 32   (hexadécimal : un caractère spécial casserait DATABASE_URL)
POSTGRES_PASSWORD=
POSTGRES_DB=langestloc

# ── Authentification ──────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ── Stockage des PDF (AWS S3) ─────────────────────────────────────────────────
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_REGION=eu-west-3
S3_BUCKET=
# Clés de l'utilisateur IAM limité à ce bucket (voir README.md)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Bailleur (en-tête des reçus et des baux PDF) ──────────────────────────────
BAILLEUR_NAME=
BAILLEUR_LIEU=
# Facultatif : représentant du bailleur
BAILLEUR_REP=
