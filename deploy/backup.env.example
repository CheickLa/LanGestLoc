# Copier en /opt/langestloc/backup.env, remplir, puis chmod 600. Ne jamais committer.

BACKUP_BUCKET=langestloc-backups-cheickla

# Clés de l'utilisateur IAM langestloc-backup-writer
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3

# Clé publique age (age1…). La clé privée ne doit jamais venir sur le serveur.
AGE_RECIPIENT=

# Adresse de signal du contrôle Healthchecks « Sauvegarde quotidienne »
HEALTHCHECK_URL=
